<Window x:Class="TaskDock11.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskDock 11 在线智能升级" 
        Height="220" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#0F1217"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Border CornerRadius="14" Background="#161B22" BorderBrush="#38BDF8" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="⚡" FontSize="20" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="正在智能下载新版本..." FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="TxtStatus" Text="连接云端服务器中..." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 进度条 -->
                <ProgressBar x:Name="PbDownload" Height="10" Margin="0,0,0,10" 
                             Minimum="0" Maximum="100" Value="0" 
                             Foreground="#38BDF8" Background="#1F2937" BorderThickness="0"/>

                <Grid>
                    <TextBlock x:Name="TxtPercent" Text="0%" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtBytes" Text="0 MB / 0 MB" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
