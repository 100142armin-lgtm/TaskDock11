<Window x:Class="TaskDock11.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskDock 11 后台静默更新" 
        Height="95" Width="340"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <!-- 底部悬浮轻量级 Toast 胶囊 -->
    <Border CornerRadius="12" Background="#161B22" BorderBrush="#38BDF8" BorderThickness="1.2" Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="14,10">
            <StackPanel VerticalAlignment="Center">
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="14" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TaskDock 11 后台更新中" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPercent" Text="0%" FontSize="11" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 纤细进度条 -->
                <ProgressBar x:Name="PbDownload" Height="5" Margin="0,0,0,6" 
                             Minimum="0" Maximum="100" Value="0" 
                             Foreground="#38BDF8" Background="#1F2937" BorderThickness="0"/>

                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="正在下载更新数据包..." FontSize="10" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtBytes" Text="0 MB / 0 MB" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
