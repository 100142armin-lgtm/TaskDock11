<Window x:Class="TaskDock11.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义应用名称" 
        Height="190" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#0F1217"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Border CornerRadius="14" Background="#161B22" BorderBrush="#38BDF8" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="✏️ 自定义应用备注名称" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                <TextBlock Text="为该窗口设置自定义名字，悬停及分组时优先显示" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,14"/>

                <TextBox x:Name="TxtCustomName" Background="#1F2937" Foreground="#FFFFFF" 
                         BorderBrush="#384152" Padding="8,6" FontSize="13" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确认" Width="75" Height="30" Background="#0284C7" Foreground="#FFFFFF" 
                            BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnOk_Click" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#38BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="取消" Width="65" Height="30" Background="#2D3748" Foreground="#94A3B8" 
                            BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
