<Window x:Class="TaskDock11.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskDock 11 - 外观与偏好设置" 
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#EEEEEE"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="TaskDock 11 设置" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="个性化调节外观、停靠模式与自动更新" FontSize="12" Foreground="#888888" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 设置项滚动区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 视觉效果 -->
                <GroupBox Header="视觉与磨砂效果" Foreground="#4CC2FF" BorderBrush="#333333" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkAcrylic" Content="启用 Windows 11 亚克力磨砂毛玻璃 (Acrylic Blur)" 
                                  Foreground="#FFFFFF" IsChecked="True" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景透明度:"/>
                            <Slider Grid.Column="1" x:Name="SliderOpacity" Minimum="0.1" Maximum="1.0" Value="0.75" 
                                    SmallChange="0.05" LargeChange="0.1"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderOpacity, StringFormat={}{0:P0}}" 
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图标大小:"/>
                            <Slider Grid.Column="1" x:Name="SliderIconSize" Minimum="28" Maximum="64" Value="40" 
                                    SmallChange="2" LargeChange="4"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderIconSize, StringFormat={}{0:0}px}" 
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景色 (HEX):"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="TxtBgColor" Width="80" Text="#1A1A1A" Margin="0,0,8,0"/>
                                <!-- 预设色彩快捷按钮 -->
                                <Button Content="深灰" Width="40" Background="#1A1A1A" Foreground="#FFF" Click="PresetColor_Click" Tag="#1A1A1A" Margin="0,0,4,0"/>
                                <Button Content="深蓝" Width="40" Background="#0C1B2A" Foreground="#FFF" Click="PresetColor_Click" Tag="#0C1B2A" Margin="0,0,4,0"/>
                                <Button Content="深紫" Width="40" Background="#1E102F" Foreground="#FFF" Click="PresetColor_Click" Tag="#1E102F" Margin="0,0,4,0"/>
                                <Button Content="纯黑" Width="40" Background="#000000" Foreground="#FFF" Click="PresetColor_Click" Tag="#000000"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 2. 位置与并存模式 -->
                <GroupBox Header="位置与屏幕工作区" Foreground="#4CC2FF" BorderBrush="#333333" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="停靠位置:"/>
                            <ComboBox Grid.Column="1" x:Name="CmbEdge" SelectedIndex="1">
                                <ComboBoxItem Content="自由浮动 (可随意拖动)"/>
                                <ComboBoxItem Content="屏幕底部 (Bottom)"/>
                                <ComboBoxItem Content="屏幕顶部 (Top)"/>
                                <ComboBoxItem Content="屏幕左侧 (Left)"/>
                                <ComboBoxItem Content="屏幕右侧 (Right)"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="并存模式:"/>
                            <ComboBox Grid.Column="1" x:Name="CmbCoexist" SelectedIndex="1">
                                <ComboBoxItem Content="避让工作区 (窗口最大化不遮挡)"/>
                                <ComboBoxItem Content="始终置顶 (浮于所有窗口上方)"/>
                                <ComboBoxItem Content="智能自动隐藏 (鼠标移开隐藏)"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 3. 系统与团队更新 -->
                <GroupBox Header="系统与团队维护" Foreground="#4CC2FF" BorderBrush="#333333" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoStart" Content="开机时自动启动 TaskDock 11" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GitHub Owner:"/>
                            <TextBox Grid.Column="1" x:Name="TxtOwner" Text="100142armin-lgtm"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GitHub Repo:"/>
                            <TextBox Grid.Column="1" x:Name="TxtRepo" Text="TaskDock11"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <Button Content="检查新版本更新" Padding="12,5" Background="#2B5B84" Foreground="#FFF" 
                                    BorderThickness="0" Cursor="Hand" Click="BtnCheckUpdate_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部保存按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="保存并应用" Width="90" Height="32" Background="#0078D4" Foreground="#FFFFFF" 
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnSave_Click" Margin="0,0,10,0"/>
            <Button Content="取消" Width="70" Height="32" Background="#333333" Foreground="#FFFFFF" 
                    BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
