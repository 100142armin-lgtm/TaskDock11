<Window x:Class="TaskDock11.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskDock 11 控制中心" 
        Height="580" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F1217"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- 基础文字样式 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 科技感卡片容器样式 -->
        <Style x:Key="TechCard" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 滑块样式 -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 下拉菜单项样式 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" CornerRadius="6" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#252D3D"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 科技暗黑 ComboBox 完整控件模板 (彻底杜绝系统白底白字) -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="▼" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="10,6,28,6" VerticalAlignment="Center"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#161B22" BorderBrush="#384152" BorderThickness="1" 
                                            CornerRadius="8" Margin="0,3,0,6" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 预设色块按钮样式 -->
        <Style x:Key="ColorBall" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}" 
                                BorderBrush="#4AFFFFFF" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主窗口外壳 -->
    <Border CornerRadius="16" Background="#0F1217" BorderBrush="#2A3441" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.7" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 科技感顶部标题栏 (带 Logo 与关闭按钮) -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 科技 Logo 呈现 -->
                <Image x:Name="ImgLogo" Grid.Column="0" Width="38" Height="38" Margin="0,0,12,0" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TaskDock 11 控制台" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#1E293B" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" BorderBrush="#38BDF8" BorderThickness="1">
                            <TextBlock Text="v1.0.3" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="实时动态渲染 · 智能应用坞" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Width="28" Height="28" Background="Transparent" 
                        BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click" VerticalAlignment="Top">
                    <TextBlock Text="✕" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. 中间卡片配置区 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                <StackPanel>
                    <!-- 卡片 A: 视觉美学 (实时所见即所得) -->
                    <Border Style="{StaticResource TechCard}">
                        <StackPanel>
                            <TextBlock Text="🎨 视觉美学与尺寸 (实时生效)" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                            <!-- 图标尺寸缩放 (实时联动) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="图标大小:"/>
                                <Slider Grid.Column="1" x:Name="SliderIconSize" Minimum="28" Maximum="64" Value="40" 
                                        SmallChange="2" LargeChange="4" ValueChanged="SettingControl_Changed"/>
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderIconSize, StringFormat={}{0:0}px}" 
                                           HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- 每行图标数 (超出自动换行双行/多行展示) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="每行图标:"/>
                                <Slider Grid.Column="1" x:Name="SliderPerRow" Minimum="6" Maximum="24" Value="12" 
                                        SmallChange="1" LargeChange="2" ValueChanged="SettingControl_Changed"/>
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderPerRow, StringFormat={}{0:0}个/行}" 
                                           HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- 背景透明度 -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="透明度:"/>
                                <Slider Grid.Column="1" x:Name="SliderOpacity" Minimum="0.1" Maximum="1.0" Value="0.85" 
                                        SmallChange="0.05" LargeChange="0.1" ValueChanged="SettingControl_Changed"/>
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderOpacity, StringFormat={}{0:P0}}" 
                                           HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- 背景色与预设色盘 (扩充至 16 款精选全色系色球) -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="面板色调:"/>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Style="{StaticResource ColorBall}" Background="#0F172A" Click="PresetColor_Click" Tag="#0F172A" ToolTip="黑曜石深空"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#020617" Click="PresetColor_Click" Tag="#020617" ToolTip="虚空纯夜黑"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#18181B" Click="PresetColor_Click" Tag="#18181B" ToolTip="钛金碳灰"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#334155" Click="PresetColor_Click" Tag="#334155" ToolTip="莫兰迪板岩灰"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#1E1B4B" Click="PresetColor_Click" Tag="#1E1B4B" ToolTip="赛博深紫"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#2E1065" Click="PresetColor_Click" Tag="#2E1065" ToolTip="银河幽紫"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#082F49" Click="PresetColor_Click" Tag="#082F49" ToolTip="星舰深蓝"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#0C4A6E" Click="PresetColor_Click" Tag="#0C4A6E" ToolTip="远洋深蓝"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#172554" Click="PresetColor_Click" Tag="#172554" ToolTip="皇家暗蓝"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#022C22" Click="PresetColor_Click" Tag="#022C22" ToolTip="极光墨绿"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#064E3B" Click="PresetColor_Click" Tag="#064E3B" ToolTip="冷杉暗绿"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#134E4A" Click="PresetColor_Click" Tag="#134E4A" ToolTip="赛博青雀"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#3F151E" Click="PresetColor_Click" Tag="#3F151E" ToolTip="炽火暗红"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#4C0519" Click="PresetColor_Click" Tag="#4C0519" ToolTip="暗夜酒红"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#451A03" Click="PresetColor_Click" Tag="#451A03" ToolTip="琥珀暗咖"/>
                                        <Button Style="{StaticResource ColorBall}" Background="#000000" Click="PresetColor_Click" Tag="#000000" ToolTip="绝对纯黑"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="HEX 颜色: " VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                        <TextBox x:Name="TxtBgColor" Width="90" Background="#1F2937" Foreground="#F8FAFC" 
                                                 BorderBrush="#374151" Padding="6,3" Text="#0F172A" TextChanged="TxtBgColor_TextChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 B: 位置停靠与屏幕避让 (实时生效) -->
                    <Border Style="{StaticResource TechCard}">
                        <StackPanel>
                            <TextBlock Text="🧭 屏幕停靠与工作区 (实时生效)" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="停靠位置:"/>
                                <ComboBox Grid.Column="1" x:Name="CmbEdge" SelectedIndex="1" SelectionChanged="SettingControl_Changed">
                                    <ComboBoxItem Content="自由浮动 (可随意拖动任意位置)"/>
                                    <ComboBoxItem Content="屏幕底部 (Bottom)"/>
                                    <ComboBoxItem Content="屏幕顶部 (Top)"/>
                                    <ComboBoxItem Content="屏幕左侧 (Left)"/>
                                    <ComboBoxItem Content="屏幕右侧 (Right)"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="共存模式:"/>
                                <ComboBox Grid.Column="1" x:Name="CmbCoexist" SelectedIndex="1" SelectionChanged="SettingControl_Changed">
                                    <ComboBoxItem Content="避让工作区 (窗口最大化不遮挡)"/>
                                    <ComboBoxItem Content="始终置顶 (浮于所有窗口上方)"/>
                                    <ComboBoxItem Content="智能自动隐藏 (鼠标离开滑出隐藏)"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 C: 系统与在线智能升级 -->
                    <Border Style="{StaticResource TechCard}">
                        <StackPanel>
                            <TextBlock Text="🚀 系统状态与智能更新" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                            <CheckBox x:Name="ChkAutoStart" Content="开机时自动静默启动 TaskDock 11" 
                                      Foreground="#E2E8F0" Margin="0,0,0,12"/>

                            <Grid Background="#1E242E">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="当前版本: v1.0.1 (最新版)" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="支持全自动无感静默在线更新" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="⚡ 智能检查更新" Padding="12,6" 
                                                Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" 
                                                Cursor="Hand" FontWeight="SemiBold" FontSize="12"
                                                Click="BtnCheckUpdate_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#38BDF8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. 底部确定与取消操作栏 -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Button Content="恢复默认" HorizontalAlignment="Left" Background="Transparent" 
                        Foreground="#64748B" BorderThickness="0" Cursor="Hand" Click="BtnResetDefault_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确认并保存" Width="100" Height="34" Background="#0284C7" Foreground="#FFFFFF" 
                            BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnSave_Click" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#38BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="取消" Width="70" Height="34" Background="#1F2937" Foreground="#94A3B8" 
                            BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#374151"/>
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
