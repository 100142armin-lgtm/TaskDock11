<Window x:Class="TaskDock11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TaskDock11.Models"
        Title="TaskDock 11"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <!-- 转换器/样式 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 扁平现代右键菜单样式 -->
        <ContextMenu x:Key="EmptyAreaContextMenu">
            <MenuItem Header="🔄 刷新应用列表" Click="MenuRefresh_Click"/>
            <MenuItem Header="⚙️ 外观与偏好设置..." Click="MenuSettings_Click"/>
            <Separator/>
            <MenuItem Header="❌ 退出 TaskDock 11" Click="MenuExit_Click"/>
        </ContextMenu>

        <!-- 窗口项模板 -->
        <DataTemplate DataType="{x:Type models:WindowItem}">
            <Border x:Name="ItemBorder" 
                    Margin="3,2" 
                    Padding="6,4" 
                    CornerRadius="8" 
                    Background="Transparent"
                    Cursor="Hand"
                    AllowDrop="True"
                    MouseMove="Item_MouseMove"
                    DragOver="Item_DragOver"
                    Drop="Item_Drop"
                    MouseLeftButtonUp="Item_MouseLeftButtonUp">
                <Border.ToolTip>
                    <ToolTip Background="#252525" Foreground="#FFFFFF" BorderBrush="#3A3A3A" 
                             Content="{Binding Title}"/>
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🚀 激活/切换窗口" Click="MenuItemActivate_Click"/>
                        <MenuItem Header="❌ 关闭窗口" Click="MenuItemClose_Click"/>
                        <MenuItem Header="⚠️ 强制结束进程 (Kill)" Click="MenuItemKill_Click" Foreground="#FF6B6B"/>
                        <Separator Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="📂 解散该分组" Click="MenuItemUngroup_Click" 
                                  Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}"/>
                        <Separator/>
                        <MenuItem Header="⚙️ 外观与偏好设置..." Click="MenuSettings_Click"/>
                        <MenuItem Header="🚪 退出程序" Click="MenuExit_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <!-- 图标与分组角标容器 -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Grid HorizontalAlignment="Center">
                            <!-- 应用图标 -->
                            <Image Width="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Height="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Source="{Binding Icon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- 如果是分组，显示右上角小文件夹徽标 -->
                            <Border Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#0078D4" CornerRadius="4" Padding="3,1" Margin="0,-3,-3,0">
                                <TextBlock Text="{Binding Children.Count}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>

                        <!-- 活动窗口底部的原生发光指示条 (如同 Win11) -->
                        <Border x:Name="ActiveIndicator" 
                                Width="16" Height="3" CornerRadius="1.5" 
                                Background="#60CDFF" Margin="0,3,0,0"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 主外壳容器（磨砂圆角胶囊卡片） -->
    <Border x:Name="MainShell"
            CornerRadius="16"
            Padding="8,4"
            ContextMenu="{StaticResource EmptyAreaContextMenu}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <StackPanel Orientation="Horizontal">
                <!-- 拖动把手 (微小的圆点指示把手) -->
                <Border Width="6" Height="22" CornerRadius="3" Background="#44FFFFFF" 
                        VerticalAlignment="Center" Margin="2,0,8,0" Cursor="SizeAll"
                        ToolTip="按住拖拽移动位置"/>

                <!-- 动态窗口应用图标列表 -->
                <ItemsControl x:Name="WindowsList" ItemsSource="{Binding Windows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 快捷设置按钮 -->
                <Button Width="28" Height="28" Margin="6,0,2,0" Background="Transparent" 
                        BorderThickness="0" Cursor="Hand" Click="MenuSettings_Click"
                        ToolTip="打开外观与偏好设置">
                    <TextBlock Text="⚙" FontSize="14" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- 分组展开弹出浮窗 (点击文件夹组时呼出) -->
            <Popup x:Name="GroupPopup" 
                   IsOpen="{Binding IsGroupPopupOpen, Mode=TwoWay}" 
                   StaysOpen="False" 
                   AllowsTransparency="True" 
                   Placement="Top">
                <Border Background="#2B2B2B" CornerRadius="12" BorderBrush="#444444" BorderThickness="1" 
                        Padding="10" Margin="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding ExpandedGroup.GroupName}" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding ExpandedGroup.Children}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel MaxWidth="280"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" Padding="6" CornerRadius="8" Background="#1F1F1F" Cursor="Hand"
                                            MouseLeftButtonUp="GroupChild_Click">
                                        <Border.ToolTip>
                                            <ToolTip Content="{Binding Title}"/>
                                        </Border.ToolTip>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="24" Height="24"/>
                                            <TextBlock Text="{Binding Title}" Foreground="#EEE" VerticalAlignment="Center" 
                                                       MaxWidth="180" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
