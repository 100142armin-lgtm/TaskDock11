<Window x:Class="TaskDock11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TaskDock11.Models"
        Title="TaskDock 11"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 全局高科技暗黑浮动菜单样式 (对标设置面板设计语言) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" 
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" CornerRadius="8" Background="Transparent" 
                                Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#222B38"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#242E3D"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 空白区域右键菜单 -->
        <ContextMenu x:Key="EmptyAreaContextMenu">
            <MenuItem Header="🔄  刷新应用列表" Click="MenuRefresh_Click"/>
            <MenuItem Header="👁️  恢复所有隐藏的应用" Click="MenuRestoreHidden_Click"/>
            <Separator/>
            <MenuItem Header="⚙️  外观与偏好设置..." Click="MenuSettings_Click"/>
            <Separator/>
            <MenuItem Header="🚪  退出 TaskDock 11" Click="MenuExit_Click"/>
        </ContextMenu>

        <!-- 应用项模板 (科技感交互动效) -->
        <DataTemplate DataType="{x:Type models:WindowItem}">
            <Border x:Name="ItemBorder" 
                    Margin="3,2" 
                    Padding="6,5" 
                    CornerRadius="10" 
                    Background="Transparent"
                    Cursor="Hand"
                    AllowDrop="True"
                    ToolTipService.InitialShowDelay="50"
                    ToolTipService.BetweenShowDelay="0"
                    ToolTipService.ShowDuration="20000"
                    PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="Item_PreviewMouseLeftButtonUp"
                    MouseMove="Item_MouseMove"
                    DragOver="Item_DragOver"
                    DragLeave="Item_DragLeave"
                    Drop="Item_Drop">
                <Border.ToolTip>
                    <ToolTip Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1"
                             Padding="12,8" HasDropShadow="True" Placement="Top">
                        <StackPanel Orientation="Vertical">
                            <!-- 主标题 (优先显示浏览器自定义昵称，如 广告-Cheng Hui) -->
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" MaxWidth="340" TextWrapping="Wrap"/>
                            <!-- 副标题 (当存在自定义昵称时，额外显示当前打开的具体网页/窗口原始标题) -->
                            <TextBlock Text="{Binding Title, StringFormat=网页: {0}}" FontSize="11" Foreground="#94A3B8" MaxWidth="340" TextWrapping="Wrap" 
                                       Margin="0,3,0,0" Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ProcessName, StringFormat=进程: {0}}" FontSize="10" Foreground="#38BDF8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🚀  激活/切换窗口" Click="MenuItemActivate_Click"/>
                        <MenuItem Header="✏️  自定义应用名称..." Click="MenuItemRename_Click"/>
                        <MenuItem Header="👁️‍🗨️  在此面板中隐藏 (不关闭应用)" Click="MenuItemHide_Click"/>
                        <Separator/>
                        <MenuItem Header="❌  关闭窗口" Click="MenuItemClose_Click"/>
                        <MenuItem Header="⚡  强制结束卡死进程 (Kill)" Click="MenuItemKill_Click" Foreground="#F87171"/>
                        <Separator Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="📂  解散此分组" Click="MenuItemUngroup_Click" 
                                  Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}"/>
                        <Separator/>
                        <MenuItem Header="⚙️  外观与偏好设置..." Click="MenuSettings_Click"/>
                        <Separator/>
                        <MenuItem Header="🚪  退出 TaskDock 11" Click="MenuExit_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <!-- 悬浮发光与图标组合 -->
                <Grid>
                    <!-- 鼠标悬停时的科技极光微光背景 -->
                    <Border x:Name="HoverGlow" 
                            CornerRadius="10" 
                            Background="#00FFFFFF" 
                            Opacity="0"/>

                    <!-- 拖拽插入与合并的强反馈视觉指示器 -->
                    <!-- 1. 左侧插入指示光条 (排在左边) -->
                    <Border x:Name="LeftInsertIndicator" Width="4" HorizontalAlignment="Left" Margin="-5,2,0,2"
                            CornerRadius="2" Background="#38BDF8" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#38BDF8" Opacity="0.95"/>
                        </Border.Effect>
                    </Border>

                    <!-- 2. 右侧插入指示光条 (排在右边) -->
                    <Border x:Name="RightInsertIndicator" Width="4" HorizontalAlignment="Right" Margin="0,2,-5,2"
                            CornerRadius="2" Background="#38BDF8" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#38BDF8" Opacity="0.95"/>
                        </Border.Effect>
                    </Border>

                    <!-- 3. 合并成组指示框 (流光脉冲紫框与角标) -->
                    <Border x:Name="MergeIndicator" CornerRadius="10" 
                            BorderBrush="#C084FC" BorderThickness="2" 
                            Background="#358B5CF6" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#C084FC" Opacity="0.95"/>
                        </Border.Effect>
                        <Border HorizontalAlignment="Center" VerticalAlignment="Top" 
                                Margin="0,-14,0,0" Padding="5,1" CornerRadius="4" Background="#7E22CE">
                            <TextBlock Text="+ 合并成组" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </Border>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Grid HorizontalAlignment="Center" x:Name="IconContainer">
                            <!-- 应用图标 -->
                            <Image Width="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Height="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Source="{Binding Icon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- 1. 会议状态角标 (极光通话绿微标) -->
                            <Border Visibility="{Binding IsInMeeting, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    CornerRadius="5" Padding="3,1" Margin="-3,-4,0,0"
                                    Background="#10B981">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.9"/>
                                </Border.Effect>
                                <TextBlock Text="● 会议" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>

                            <!-- 2. 通讯未读新消息角标 (霓虹脉冲红橙徽标) -->
                            <Border Visibility="{Binding HasNotification, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    CornerRadius="7" Padding="4,1" Margin="0,-5,-5,0"
                                    Background="#EF4444">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#EF4444" Opacity="0.9"/>
                                </Border.Effect>
                                <TextBlock Text="{Binding NotificationText}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>

                            <!-- 3. 分组角标 (渐变流光胶囊) -->
                            <Border Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    CornerRadius="6" Padding="4,1" Margin="0,-4,-4,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#06B6D4" Offset="0.0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding Children.Count}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>

                        <!-- 活动窗口底部的未来感发光胶囊指示条 -->
                        <Border x:Name="ActiveIndicator" 
                                Width="14" Height="3" CornerRadius="1.5" 
                                Margin="0,4,0,0"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#38BDF8" Offset="0.0"/>
                                    <GradientStop Color="#818CF8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#38BDF8" Opacity="0.9"/>
                            </Border.Effect>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverGlow" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#25FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#10FFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="HoverGlow" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 外层流光投影容器 -->
    <Grid Margin="12">
        <!-- 主玻璃舱体 -->
        <Border x:Name="MainShell"
                CornerRadius="18"
                Padding="10,5"
                BorderThickness="1"
                MouseLeftButtonDown="MainShell_MouseLeftButtonDown"
                ContextMenu="{StaticResource EmptyAreaContextMenu}">
            <!-- 默认高质感玻璃边框与投影 -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4AFFFFFF" Offset="0.0"/>
                    <GradientStop Color="#15FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 未来感把手 (双段发光条) -->
                    <Border x:Name="DragHandle" Width="14" Background="Transparent" Cursor="SizeAll" Margin="0,0,6,0"
                            MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                            ToolTip="按住拖动位置" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="4" Height="10" CornerRadius="2" Background="#38BDF8" Opacity="0.75" Margin="0,0,0,3"/>
                            <Border Width="4" Height="10" CornerRadius="2" Background="#818CF8" Opacity="0.75"/>
                        </StackPanel>
                    </Border>

                    <!-- 动态窗口应用图标列表 (智能双行/多行折行) -->
                    <ItemsControl x:Name="WindowsList" ItemsSource="{Binding Windows}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="{Binding DataContext.Settings.WrapMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}" 
                                           Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 分组展开弹出浮窗 -->
                <Popup x:Name="GroupPopup" 
                       IsOpen="{Binding IsGroupPopupOpen, Mode=TwoWay}" 
                       StaysOpen="False" 
                       AllowsTransparency="True" 
                       Placement="Top">
                    <Border Background="#161B22" CornerRadius="14" BorderThickness="1" 
                            Padding="12" Margin="10">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#38BDF8" Offset="0.0"/>
                                <GradientStop Color="#818CF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding ExpandedGroup.GroupName}" FontWeight="SemiBold" 
                                       Foreground="#F1F5F9" FontSize="13" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding ExpandedGroup.Children}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel MaxWidth="280"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4" Padding="6,5" CornerRadius="8" Background="#21262D" Cursor="Hand"
                                                MouseLeftButtonUp="GroupChild_Click">
                                            <Border.ToolTip>
                                                <ToolTip Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1"
                                                         Padding="10,6" HasDropShadow="True" Placement="Top">
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" MaxWidth="300" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Title, StringFormat=网页: {0}}" FontSize="10" Foreground="#94A3B8" MaxWidth="300" TextWrapping="Wrap" 
                                                                   Margin="0,2,0,0" Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="22" Height="22"/>
                                                <TextBlock Text="{Binding DisplayTitle}" Foreground="#E2E8F0" VerticalAlignment="Center" 
                                                           MaxWidth="170" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
