<Window x:Class="TaskDock11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TaskDock11.Models"
        Title="TaskDock 11"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 极简科技感右键菜单 -->
        <ContextMenu x:Key="EmptyAreaContextMenu">
            <ContextMenu.Resources>
                <Style TargetType="ContextMenu">
                    <Setter Property="Background" Value="#1A1D24"/>
                    <Setter Property="BorderBrush" Value="#384152"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="4"/>
                </Style>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="🔄  刷新应用列表" Click="MenuRefresh_Click"/>
            <MenuItem Header="⚙️  外观与偏好设置..." Click="MenuSettings_Click"/>
            <Separator Background="#2D3748"/>
            <MenuItem Header="🚪  退出 TaskDock 11" Click="MenuExit_Click"/>
        </ContextMenu>

        <!-- 应用项模板 (科技感交互动效) -->
        <DataTemplate DataType="{x:Type models:WindowItem}">
            <Border x:Name="ItemBorder" 
                    Margin="3,2" 
                    Padding="6,5" 
                    CornerRadius="10" 
                    Background="Transparent"
                    Cursor="Hand"
                    AllowDrop="True"
                    MouseMove="Item_MouseMove"
                    DragOver="Item_DragOver"
                    Drop="Item_Drop"
                    MouseLeftButtonUp="Item_MouseLeftButtonUp">
                <Border.ToolTip>
                    <ToolTip Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1"
                             Content="{Binding Title}" Padding="8,4"/>
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu Background="#1A1D24" BorderBrush="#384152" BorderThickness="1">
                        <MenuItem Header="🚀  激活/切换窗口" Click="MenuItemActivate_Click" Foreground="#E2E8F0"/>
                        <MenuItem Header="❌  关闭窗口" Click="MenuItemClose_Click" Foreground="#E2E8F0"/>
                        <MenuItem Header="⚡  强制结束卡死进程 (Kill)" Click="MenuItemKill_Click" Foreground="#F87171"/>
                        <Separator Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}" Background="#2D3748"/>
                        <MenuItem Header="📂  解散此分组" Click="MenuItemUngroup_Click" 
                                  Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}" Foreground="#38BDF8"/>
                        <Separator Background="#2D3748"/>
                        <MenuItem Header="⚙️  外观与设置..." Click="MenuSettings_Click" Foreground="#E2E8F0"/>
                        <MenuItem Header="🚪  退出" Click="MenuExit_Click" Foreground="#94A3B8"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <!-- 悬浮发光与图标组合 -->
                <Grid>
                    <!-- 鼠标悬停时的科技极光微光背景 -->
                    <Border x:Name="HoverGlow" 
                            CornerRadius="10" 
                            Background="#00FFFFFF" 
                            Opacity="0"/>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Grid HorizontalAlignment="Center" x:Name="IconContainer">
                            <!-- 应用图标 -->
                            <Image Width="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Height="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Source="{Binding Icon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- 分组角标 (渐变流光胶囊) -->
                            <Border Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    CornerRadius="6" Padding="4,1" Margin="0,-4,-4,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#06B6D4" Offset="0.0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding Children.Count}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>

                        <!-- 活动窗口底部的未来感发光胶囊指示条 -->
                        <Border x:Name="ActiveIndicator" 
                                Width="14" Height="3" CornerRadius="1.5" 
                                Margin="0,4,0,0"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#38BDF8" Offset="0.0"/>
                                    <GradientStop Color="#818CF8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#38BDF8" Opacity="0.9"/>
                            </Border.Effect>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverGlow" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#25FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#10FFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="HoverGlow" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 外层流光投影容器 -->
    <Grid Margin="12">
        <!-- 主玻璃舱体 -->
        <Border x:Name="MainShell"
                CornerRadius="18"
                Padding="10,5"
                BorderThickness="1"
                ContextMenu="{StaticResource EmptyAreaContextMenu}">
            <!-- 默认高质感玻璃边框与投影 -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4AFFFFFF" Offset="0.0"/>
                    <GradientStop Color="#15FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 未来感把手 (双段发光条) -->
                    <Border Width="12" Background="Transparent" Cursor="SizeAll" Margin="0,0,6,0"
                            ToolTip="按住拖动位置" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="4" Height="10" CornerRadius="2" Background="#38BDF8" Opacity="0.75" Margin="0,0,0,3"/>
                            <Border Width="4" Height="10" CornerRadius="2" Background="#818CF8" Opacity="0.75"/>
                        </StackPanel>
                    </Border>

                    <!-- 动态窗口应用图标列表 -->
                    <ItemsControl x:Name="WindowsList" ItemsSource="{Binding Windows}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 科技感快捷设置呼出按钮 -->
                    <Button Width="26" Height="26" Margin="6,0,0,0" Background="#1AFFFFFF" 
                            BorderThickness="0" Cursor="Hand" Click="MenuSettings_Click"
                            ToolTip="打开外观与偏好设置">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" CornerRadius="13" Background="{TemplateBinding Background}">
                                    <TextBlock Text="⚙" FontSize="13" Foreground="#94A3B8" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#38BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- 分组展开弹出浮窗 -->
                <Popup x:Name="GroupPopup" 
                       IsOpen="{Binding IsGroupPopupOpen, Mode=TwoWay}" 
                       StaysOpen="False" 
                       AllowsTransparency="True" 
                       Placement="Top">
                    <Border Background="#161B22" CornerRadius="14" BorderThickness="1" 
                            Padding="12" Margin="10">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#38BDF8" Offset="0.0"/>
                                <GradientStop Color="#818CF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding ExpandedGroup.GroupName}" FontWeight="SemiBold" 
                                       Foreground="#F1F5F9" FontSize="13" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding ExpandedGroup.Children}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel MaxWidth="280"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4" Padding="6,5" CornerRadius="8" Background="#21262D" Cursor="Hand"
                                                MouseLeftButtonUp="GroupChild_Click">
                                            <Border.ToolTip>
                                                <ToolTip Content="{Binding Title}"/>
                                            </Border.ToolTip>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="22" Height="22"/>
                                                <TextBlock Text="{Binding Title}" Foreground="#E2E8F0" VerticalAlignment="Center" 
                                                           MaxWidth="170" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
